# Mnemosyne AI Configuration
# Copy this file to .env and configure your settings

# ─── LLM Provider ──────────────────────────────────────────
# Options: "openrouter", "ollama", "fallback"
# "fallback" works without any API key (limited responses)
LLM_PROVIDER=fallback

# ─── OpenRouter (Cloud LLM - paid) ─────────────────────────
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ─── Ollama (Local LLM - free) ─────────────────────────────
# Install: https://ollama.ai
# Start: ollama serve
# Pull a model: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ─── Model Selection ───────────────────────────────────────
DEFAULT_CHAT_MODEL=openai/gpt-4o-mini
DEFAULT_REASONING_MODEL=openai/gpt-4o-mini
DEFAULT_SUMMARY_MODEL=openai/gpt-4o-mini

# ─── App Settings ──────────────────────────────────────────
APP_NAME=Mnemosyne AI
APP_URL=http://localhost:8000
DEBUG=true
